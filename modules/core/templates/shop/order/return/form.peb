{% extends "core" %}

{% block title %}{{ i18n("common", "PAGE_TITLE_RETURN_FORM") }}{% endblock %}

{% block content %}
<div class="w-full px-4 py-8">
  <div class="max-w-2xl mx-auto">

    <h1 class="text-2xl font-bold mb-2">{{ i18n("common", "RETURN_HEADING") }}</h1>
    <p class="opacity-60 mb-6">{{ i18n("common", "RETURN_INTRO") }}</p>

    {% if error is defined and error is not empty %}
    <div class="alert alert-error mb-6">
      <span>{{ error }}</span>
    </div>
    {% endif %}

    {% if formError is defined and formError is not empty %}
    <div class="alert alert-warning mb-4">
      <span>{{ formError }}</span>
    </div>
    {% endif %}

    {% if order is defined %}
    <form method="post" action="/order/return/create">
      <input type="hidden" name="token" value="{{ token }}"/>

      <!-- Item selection -->
      <div class="card bg-base-200 mb-6">
        <div class="card-body">
          <h2 class="card-title text-base mb-4">{{ i18n("common", "SELECT_ITEMS") }}</h2>
          <div class="overflow-x-auto">
            <table class="table">
              <thead>
                <tr>
                  <th></th>
                  <th>{{ i18n("common", "PRODUCT") }}</th>
                  <th class="text-center">{{ i18n("common", "MAX_QUANTITY") }}</th>
                  <th class="text-center">{{ i18n("common", "RETURN_QUANTITY") }}</th>
                </tr>
              </thead>
              <tbody>
                {% for item in orderItems %}
                <tr>
                  <td>
                    <input type="checkbox" name="itemId" value="{{ item.id }}"
                           class="checkbox checkbox-primary" id="item_{{ item.id }}"/>
                  </td>
                  <td>
                    <label for="item_{{ item.id }}" class="cursor-pointer font-medium">{{ item.productName }}</label>
                  </td>
                  <td class="text-center opacity-70">{{ item.quantity }}</td>
                  <td class="text-center">
                    <input type="number" name="qty_{{ item.id }}" value="{{ item.quantity }}"
                           min="1" max="{{ item.quantity }}"
                           class="input input-bordered input-sm w-20"/>
                  </td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Reason -->
      <div class="card bg-base-200 mb-6">
        <div class="card-body">
          <h2 class="card-title text-base mb-4">{{ i18n("common", "RETURN_REASON") }}</h2>
          <select name="reason" class="select select-bordered w-full" required>
            <option value="">{{ i18n("common", "SELECT_REASON") }}</option>
            {% for r in reasons %}
              {% if r == "DEFECTIVE" %}
                <option value="{{ r }}">{{ i18n("common", "REASON_DEFECTIVE") }}</option>
              {% elseif r == "WRONG_ITEM" %}
                <option value="{{ r }}">{{ i18n("common", "REASON_WRONG_ITEM") }}</option>
              {% elseif r == "NOT_AS_DESCRIBED" %}
                <option value="{{ r }}">{{ i18n("common", "REASON_NOT_AS_DESCRIBED") }}</option>
              {% elseif r == "CHANGED_MIND" %}
                <option value="{{ r }}">{{ i18n("common", "REASON_CHANGED_MIND") }}</option>
              {% else %}
                <option value="{{ r }}">{{ i18n("common", "REASON_OTHER") }}</option>
              {% endif %}
            {% endfor %}
          </select>
        </div>
      </div>

      <!-- Bank account -->
      <div class="card bg-base-200 mb-8">
        <div class="card-body">
          <h2 class="card-title text-base mb-1">{{ i18n("common", "BANK_ACCOUNT") }}</h2>
          <p class="text-sm opacity-60 mb-3">{{ i18n("common", "BANK_ACCOUNT_NOTE") }}</p>
          <input type="text" name="bankAccount" placeholder="123456789/0100"
                 class="input input-bordered w-full" required/>
        </div>
      </div>

      <div class="flex justify-between">
        <a href="/order/status?token={{ token }}" class="btn btn-ghost">{{ i18n("common", "BACK_TO_ORDER") }}</a>
        <button type="submit" class="btn btn-error">
          {{ i18n("common", "CREATE_RETURN") }}
        </button>
      </div>
    </form>
    {% endif %}

  </div>
</div>
{% endblock %}
