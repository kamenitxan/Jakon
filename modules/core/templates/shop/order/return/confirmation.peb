{% extends "core" %}

{% block title %}{{ i18n("common", "RETURN_CREATED") }} – {{ orderReturn.returnNumber }}{% endblock %}

{% block content %}
<div class="w-full px-4 py-16">
  <div class="max-w-lg mx-auto text-center">

    {% if error is defined and error is not empty %}
    <div class="alert alert-error mb-6"><span>{{ error }}</span></div>
    {% else %}

    <div class="flex justify-center mb-6">
      <div class="w-20 h-20 rounded-full bg-info flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-info-content" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      </div>
    </div>

    <h1 class="text-3xl font-bold mb-2">{{ i18n("common", "RETURN_CREATED") }}</h1>
    <p class="opacity-70 mb-6">{{ i18n("common", "RETURN_ACCEPTED") }}</p>

    <div class="badge badge-lg badge-primary mb-8">{{ orderReturn.returnNumber }}</div>

    <!-- Shipping instructions -->
    <div class="card bg-base-200 text-left mb-8">
      <div class="card-body">
        <h2 class="card-title text-base mb-3">{{ i18n("common", "RETURN_SEND_TO") }}</h2>

        {% if returnAddress.name is not empty %}
        <address class="not-italic leading-relaxed mb-4">
          <p class="font-bold">{{ returnAddress.name }}</p>
          <p>{{ returnAddress.street }}</p>
          <p>{{ returnAddress.zip }} {{ returnAddress.city }}</p>
          <p>{{ returnAddress.country }}</p>
        </address>
        {% else %}
        <p class="opacity-60 italic">{{ i18n("common", "RETURN_NO_ADDRESS") }}</p>
        {% endif %}

        <div class="divider my-2"></div>

        <h3 class="font-semibold mb-2">{{ i18n("common", "RETURN_LABEL_INSTRUCTIONS") }}</h3>
        <ul class="list-disc list-inside space-y-1 text-sm opacity-80">
          <li>{{ i18n("common", "RETURN_LABEL_NUMBER") }} <strong>{{ orderReturn.returnNumber }}</strong></li>
          <li>{{ i18n("common", "RETURN_LABEL_SENDER") }}</li>
          <li>{{ i18n("common", "RETURN_LABEL_REGISTERED") }}</li>
        </ul>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      {% if token is defined and token is not empty %}
      <a href="/order/status?token={{ token }}" class="btn btn-outline">{{ i18n("common", "BACK_TO_ORDER_SHORT") }}</a>
      {% endif %}
      <a href="/" class="btn btn-ghost">{{ i18n("common", "CONTINUE_SHOPPING") }}</a>
    </div>

    {% endif %}
  </div>
</div>
{% endblock %}
