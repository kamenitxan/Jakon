{% extends "core" %}

{% block title %}Košík - My Shop{% endblock %}

{% block content %}
<div class="w-full px-4 py-8">

  <!-- Indikátor kroků -->
  <ul class="steps steps-horizontal w-full mb-8">
    <li class="step step-primary">Košík</li>
    <li class="step">Doprava a platba</li>
    <li class="step">Doručovací údaje</li>
  </ul>

  <h1 class="text-2xl font-bold mb-6">Váš košík</h1>

  {% if cartItems is empty %}
  <div class="alert alert-info">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <span>Váš košík je prázdný. <a href="/" class="link">Pokračovat v nakupování</a></span>
  </div>
  {% else %}

  <div class="overflow-x-auto">
    <table class="table table-zebra w-full">
      <thead>
        <tr>
          <th>Produkt</th>
          <th class="text-center">Množství</th>
          <th class="text-right">Cena/ks</th>
          <th class="text-right">Celkem</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {% for item in cartItems %}
        <tr>
          <td>
            <div class="flex items-center gap-3">
              {% if item.product.mainImage %}
              <div class="avatar">
                <div class="mask mask-squircle w-12 h-12">
                  <img src="{{ item.product.mainImage }}" alt="{{ item.product.name }}" />
                </div>
              </div>
              {% endif %}
              <div>
                <div class="font-bold">{{ item.product.name }}</div>
                <div class="text-sm opacity-60">{{ item.product.sku }}</div>
                {% if variantTexts is not empty and variantTexts[item.id] %}
                <div class="text-sm opacity-80 mt-1">{{ variantTexts[item.id] }}</div>
                {% endif %}
              </div>
            </div>
          </td>
          <td class="text-center">
            <form method="post" action="/cart/update" class="flex items-center justify-center gap-2">
              <input type="hidden" name="itemId" value="{{ item.id }}" />
              <input type="number" name="quantity" value="{{ item.quantity }}" min="0" max="999"
                     class="input input-bordered input-sm w-20 text-center" />
              <button type="submit" class="btn btn-sm btn-ghost">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
              </button>
            </form>
          </td>
          <td class="text-right">
            {% if item.product.discountPrice is not null %}
              <span class="line-through opacity-50 text-sm">{{ item.product.price }} Kč</span><br/>
              <span class="text-primary font-bold">{{ item.product.discountPrice }} Kč</span>
            {% else %}
              <span>{{ item.product.price }} Kč</span>
            {% endif %}
          </td>
          <td class="text-right font-bold">
            {% if item.product.discountPrice is not null %}
              {{ (item.product.discountPrice * item.quantity) }} Kč
            {% else %}
              {{ (item.product.price * item.quantity) }} Kč
            {% endif %}
          </td>
          <td>
            <form method="post" action="/cart/update">
              <input type="hidden" name="itemId" value="{{ item.id }}" />
              <input type="hidden" name="quantity" value="0" />
              <button type="submit" class="btn btn-sm btn-ghost btn-error">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              </button>
            </form>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <!-- Souhrn -->
  <div class="flex justify-end mt-6">
    <div class="card bg-base-200 w-80">
      <div class="card-body">
        <div class="flex justify-between text-lg font-bold">
          <span>Celkem:</span>
          <span class="text-primary">{{ total }} Kč</span>
        </div>
        <p class="text-sm opacity-60">Bez dopravy a platby</p>
        <div class="card-actions justify-end mt-4">
          <a href="/" class="btn btn-ghost">Pokračovat v nakupování</a>
          <a href="/cart/checkout" class="btn btn-primary">
            Pokračovat k dopravě
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  {% endif %}
</div>
{% endblock %}
