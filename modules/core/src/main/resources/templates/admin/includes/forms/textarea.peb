{# @pebvariable name="field" type="cz.kamenitxan.jakon.webui.entity.FieldInfo" #}
{# @pebvariable name="fieldHash" type="java.lang.Integer" #}
{# @pebvariable name="lng" type="java.lang.String" #}

<div class="jakon-editor-wrapper" id="jakon-editor-wrapper-{{ fieldHash }}" data-editorId="{{ fieldHash }}" data-locale="{{ locale() }}">
		<textarea class="form-control" name="{{ field.name }}{{ lng }}" cols="80" rows="5" id="ta-{{ fieldHash }}">{{ field.value | raw }}</textarea>
	<div class="jakon-editor-toolbar">

		<button class="jakon-editor-toolbar-button btn btn-light undo" title="{{ i18n("common","EDITOR_UNDO") }} (Ctrl+Z)" aria-label="{{ i18n("common","EDITOR_UNDO") }}" disabled>
			<i class="fa-solid fa-rotate-left"></i>
		</button>
		<button class="jakon-editor-toolbar-button btn btn-light redo" title="{{ i18n("common","EDITOR_REDO") }} (Ctrl+Y)" aria-label="{{ i18n("common","EDITOR_REDO") }}" disabled>
			<i class="fa-solid fa-rotate-right"></i>
		</button>

		<div class="dropdown block-type-dropdown">
			<button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
				Dropdown button
			</button>
			<ul class="dropdown-menu">
				<li class="text-type-normal">
					<div class="dropdown-item"><i class="fa-solid fa-paragraph"></i> <span class="text">{{ i18n("common","EDITOR_NORMAL") }}</span>
						<span class="shortcut">Ctrl+Alt+0</span>
					</div>
				</li>
				<li class="text-type-h1">
					<div class="dropdown-item"><i class="fa-solid fa-heading"></i> <span class="text">{{ i18n("common","EDITOR_HEADING_1") }}</span>
						<span class="shortcut">Ctrl+Alt+1</span>
					</div>
				</li>
				<li class="text-type-h2">
					<div class="dropdown-item"><i class="fa-solid fa-heading"></i> <span class="text">{{ i18n("common","EDITOR_HEADING_2") }}</span>
						<span class="shortcut">Ctrl+Alt+2</span>
					</div>
				</li>
				<li class="text-type-h3">
					<div class="dropdown-item"><i class="fa-solid fa-heading"></i> <span class="text">{{ i18n("common","EDITOR_HEADING_3") }}</span>
						<span class="shortcut">Ctrl+Alt+3</span>
					</div>
				</li>
				<li class="text-type-bullet">
					<div class="dropdown-item"><i class="fa-solid fa-list-ul"></i> <span class="text">{{ i18n("common","EDITOR_BULLET_LIST") }}</span>
						<span class="shortcut">TODO</span>
					</div>
				</li>
			</ul>
		</div>

		<button class="jakon-editor-toolbar-button btn btn-light bold" title="{{ i18n("common","EDITOR_BOLD") }} (Ctrl+B)" aria-label="{{ i18n("common","EDITOR_BOLD") }}">
			<i class="fa-solid fa-bold"></i>
		</button>
		<button class="jakon-editor-toolbar-button btn btn-light italic" title="{{ i18n("common","EDITOR_ITALIC") }} (Ctrl+I)" aria-label="{{ i18n("common","EDITOR_ITALIC") }}">
			<i class="fa-solid fa-italic"></i>
		</button>
		<button class="jakon-editor-toolbar-button btn btn-light strikethrough" title="{{ i18n("common","EDITOR_STRIKETHROUGH") }} (Ctrl+Shift+X)" aria-label="{{ i18n("common","EDITOR_STRIKETHROUGH") }}">
			<i class="fa-solid fa-strikethrough"></i>
		</button>
		<button class="jakon-editor-toolbar-button btn btn-light link" title="{{ i18n("common","EDITOR_LINK") }} (Ctrl+K)" aria-label="{{ i18n("common","EDITOR_LINK") }}">
			<i class="fa-solid fa-link"></i>
		</button>
		<button class="jakon-editor-toolbar-button btn btn-light image" title="{{ i18n("common","EDITOR_INSERT_IMAGE") }}" aria-label="{{ i18n("common","EDITOR_INSERT_IMAGE") }}">
			<i class="fa-solid fa-image"></i>
		</button>
		<button class="jakon-editor-toolbar-button btn btn-light hr" title="{{ i18n("common","EDITOR_HORIZONTAL_RULE") }}" aria-label="{{ i18n("common","EDITOR_HORIZONTAL_RULE") }}">
			<i class="fa-solid fa-minus"></i>
		</button>
		<button class="jakon-editor-toolbar-button btn btn-light code-block" title="{{ i18n("common","EDITOR_CODE_BLOCK") }}" aria-label="{{ i18n("common","EDITOR_CODE_BLOCK") }}">
			<i class="fa-solid fa-code"></i>
		</button>

		<button
				class="shortcuts-toggle btn btn-light"
				title="{{ i18n("common","EDITOR_SHORTCUTS") }}"
				aria-label="{{ i18n("common","EDITOR_SHORTCUTS") }}"
				data-bs-toggle="modal"
				data-bs-target="#shortcutsModal-{{ fieldHash }}">
			<i class="fa-regular fa-keyboard"></i>
		</button>
		<button
				class="markdown-toggle action-button btn btn-light"
				title="{{ i18n("common","EDITOR_MARKDOWN_VIEW") }}"
				aria-label="{{ i18n("common","EDITOR_MARKDOWN_VIEW") }}">
			<i class="fa-brands fa-markdown"></i>
		</button>
	</div>
	<div class="form-control lexical-editor" id="lexical-editor-{{ fieldHash }}" contenteditable>

	</div>


	<div class="linkEditorModal modal " id="linkEditorModal-{{ fieldHash }}" tabindex="-1" aria-labelledby="linkEditorModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content">
				<div class="modal-header">
					<h1 class="modal-title fs-5" id="linkEditorModalLabel">{{ i18n("common","EDITOR_LINK_EDIT_TITLE") }}</h1>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ i18n("common","EDITOR_CLOSE") }}"></button>
				</div>
				<div class="modal-body">
						<div class="mb-3">
							<label for="link-text-{{ fieldHash }}" class="col-form-label">{{ i18n("common","EDITOR_LINK_TEXT") }}</label>
							<input type="text" class="form-control linkText" id="link-text-{{ fieldHash }}">
						</div>
						<div class="mb-3">
							<label for="link-url-{{ fieldHash }}" class="col-form-label">{{ i18n("common","EDITOR_LINK_URL") }}</label>
							<input type="text" class="form-control linkUrl" id="link-url-{{ fieldHash }}">
						</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ i18n("common","EDITOR_CLOSE") }}</button>
					<button type="button" class="btn btn-danger remove-link-{{ fieldHash }}">{{ i18n("common","EDITOR_REMOVE_LINK") }}</button>
					<button type="button" class="btn btn-primary save-link-{{ fieldHash }}">{{ i18n("common","EDITOR_SAVE_LINK") }}</button>
				</div>
			</div>
		</div>
	</div>
	<div class="image_selector"></div>
	<div class="shortcutsModal modal" id="shortcutsModal-{{ fieldHash }}" tabindex="-1" aria-labelledby="shortcutsModalLabel-{{ fieldHash }}" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content">
				<div class="modal-header">
					<h1 class="modal-title fs-5" id="shortcutsModalLabel-{{ fieldHash }}">{{ i18n("common","EDITOR_SHORTCUTS") }}</h1>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ i18n("common","EDITOR_CLOSE") }}"></button>
				</div>
				<div class="modal-body">
					<p class="text-muted small">{{ i18n("common","EDITOR_SHORTCUTS_MAC_NOTE") }}</p>
					<table class="table">
						<thead><tr><th>{{ i18n("common","EDITOR_ACTION") }}</th><th>{{ i18n("common","EDITOR_SHORTCUT") }}</th></tr></thead>
						<tbody>
							<tr><td>{{ i18n("common","EDITOR_BOLD") }}</td><td><kbd>Ctrl</kbd> + <kbd>B</kbd></td></tr>
							<tr><td>{{ i18n("common","EDITOR_ITALIC") }}</td><td><kbd>Ctrl</kbd> + <kbd>I</kbd></td></tr>
							<tr><td>{{ i18n("common","EDITOR_LINK") }}</td><td><kbd>Ctrl</kbd> + <kbd>K</kbd></td></tr>
							<tr><td>{{ i18n("common","EDITOR_STRIKETHROUGH") }}</td><td><kbd>Ctrl</kbd> + <kbd>Shift</kbd> + <kbd>X</kbd></td></tr>
							<tr><td>{{ i18n("common","EDITOR_NORMAL_TEXT") }}</td><td><kbd>Ctrl</kbd> + <kbd>Shift</kbd> + <kbd>0</kbd></td></tr>
							<tr><td>{{ i18n("common","EDITOR_HEADINGS") }}</td><td><kbd>Ctrl</kbd> + <kbd>Shift</kbd> + <kbd>1</kbd> / <kbd>2</kbd> / <kbd>3</kbd></td></tr>
							<tr><td>{{ i18n("common","EDITOR_UNDO") }}</td><td><kbd>Ctrl</kbd> + <kbd>Z</kbd></td></tr>
							<tr><td>{{ i18n("common","EDITOR_REDO") }}</td><td><kbd>Ctrl</kbd> + <kbd>Shift</kbd> + <kbd>Z</kbd> / <kbd>Ctrl</kbd> + <kbd>Y</kbd></td></tr>
							<tr><td>{{ i18n("common","EDITOR_INSERT_EMOJI") }}</td><td><kbd>:</kbd> {{ i18n("common","EDITOR_EMOJI_HINT") }}</td></tr>
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>

</div>
