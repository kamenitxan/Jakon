{% extends "core" %}

{% block title %}Odstoupení od smlouvy{% endblock %}

{% block content %}
<div class="w-full px-4 py-8">
  <div class="max-w-2xl mx-auto">

    <h1 class="text-2xl font-bold mb-2">Odstoupení od smlouvy</h1>
    <p class="opacity-60 mb-6">Vyberte zboží, které chcete vrátit, a vyplňte požadované údaje.</p>

    {% if error is defined and error is not empty %}
    <div class="alert alert-error mb-6">
      <span>{{ error }}</span>
    </div>
    {% endif %}

    {% if formError is defined and formError is not empty %}
    <div class="alert alert-warning mb-4">
      <span>{{ formError }}</span>
    </div>
    {% endif %}

    {% if order is defined %}
    <form method="post" action="/order/return/create">
      <input type="hidden" name="token" value="{{ token }}"/>

      <!-- Item selection -->
      <div class="card bg-base-200 mb-6">
        <div class="card-body">
          <h2 class="card-title text-base mb-4">Vyberte položky k vrácení</h2>
          <div class="overflow-x-auto">
            <table class="table">
              <thead>
                <tr>
                  <th></th>
                  <th>Produkt</th>
                  <th class="text-center">Max. množství</th>
                  <th class="text-center">Vrátit kusů</th>
                </tr>
              </thead>
              <tbody>
                {% for item in orderItems %}
                <tr>
                  <td>
                    <input type="checkbox" name="itemId" value="{{ item.id }}"
                           class="checkbox checkbox-primary" id="item_{{ item.id }}"/>
                  </td>
                  <td>
                    <label for="item_{{ item.id }}" class="cursor-pointer font-medium">{{ item.productName }}</label>
                  </td>
                  <td class="text-center opacity-70">{{ item.quantity }}</td>
                  <td class="text-center">
                    <input type="number" name="qty_{{ item.id }}" value="{{ item.quantity }}"
                           min="1" max="{{ item.quantity }}"
                           class="input input-bordered input-sm w-20"/>
                  </td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Reason -->
      <div class="card bg-base-200 mb-6">
        <div class="card-body">
          <h2 class="card-title text-base mb-4">Důvod vrácení</h2>
          <select name="reason" class="select select-bordered w-full" required>
            <option value="">-- Vyberte důvod --</option>
            {% for r in reasons %}
              {% if r == "DEFECTIVE" %}
                <option value="{{ r }}">Vadné zboží</option>
              {% elseif r == "WRONG_ITEM" %}
                <option value="{{ r }}">Obdržel jsem jiné zboží</option>
              {% elseif r == "NOT_AS_DESCRIBED" %}
                <option value="{{ r }}">Zboží neodpovídá popisu</option>
              {% elseif r == "CHANGED_MIND" %}
                <option value="{{ r }}">Změna rozhodnutí</option>
              {% else %}
                <option value="{{ r }}">Jiné</option>
              {% endif %}
            {% endfor %}
          </select>
        </div>
      </div>

      <!-- Bank account -->
      <div class="card bg-base-200 mb-8">
        <div class="card-body">
          <h2 class="card-title text-base mb-1">Číslo bankovního účtu pro vrácení peněz</h2>
          <p class="text-sm opacity-60 mb-3">Na tento účet vám zašleme peníze po obdržení zboží.</p>
          <input type="text" name="bankAccount" placeholder="123456789/0100"
                 class="input input-bordered w-full" required/>
        </div>
      </div>

      <div class="flex justify-between">
        <a href="/order/status?token={{ token }}" class="btn btn-ghost">← Zpět na objednávku</a>
        <button type="submit" class="btn btn-error">
          Vytvořit odstoupení
        </button>
      </div>
    </form>
    {% endif %}

  </div>
</div>
{% endblock %}
