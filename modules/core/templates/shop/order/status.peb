{% extends "core" %}

{% block title %}Stav objednávky - My Shop{% endblock %}

{% block content %}
<div class="w-full px-4 py-8">
  <div class="max-w-3xl mx-auto">

    <h1 class="text-2xl font-bold mb-6">Stav objednávky</h1>

    {% if error is defined and error != "" %}
    <div class="alert alert-error">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>{{ error }}</span>
    </div>
    {% else %}

    <!-- Hlavička objednávky -->
    <div class="card bg-base-200 mb-6">
      <div class="card-body">
        <div class="flex flex-wrap justify-between items-start gap-4">
          <div>
            <p class="text-sm opacity-60">Číslo objednávky</p>
            <p class="text-xl font-bold">{{ order.orderNumber }}</p>
          </div>
          <div>
            <p class="text-sm opacity-60">Datum objednávky</p>
            <p class="font-medium">{{ order.orderDate | date("d.M.yyyy HH:mm") }}</p>
          </div>
          <div>
            <p class="text-sm opacity-60 mb-1">Stav</p>
            {% if order.status == "NEW" %}
              <span class="badge badge-info badge-lg">Nová</span>
            {% elseif order.status == "PROCESSING" %}
              <span class="badge badge-warning badge-lg">Zpracovává se</span>
            {% elseif order.status == "SHIPPED" %}
              <span class="badge badge-primary badge-lg">Odesláno</span>
            {% elseif order.status == "DELIVERED" %}
              <span class="badge badge-success badge-lg">Doručeno</span>
            {% elseif order.status == "CANCELLED" %}
              <span class="badge badge-error badge-lg">Zrušeno</span>
            {% else %}
              <span class="badge badge-neutral badge-lg">{{ order.status }}</span>
            {% endif %}
          </div>
          <div>
            <p class="text-sm opacity-60">Zaplaceno</p>
            {% if order.isPaid %}
              <span class="badge badge-success">Ano</span>
            {% else %}
              <span class="badge badge-warning">Ne</span>
            {% endif %}
          </div>
        </div>
      </div>
    </div>

    <!-- Položky -->
    <div class="card bg-base-200 mb-6">
      <div class="card-body">
        <h2 class="card-title mb-4">Položky objednávky</h2>
        <div class="overflow-x-auto">
          <table class="table table-zebra">
            <thead>
              <tr>
                <th>Produkt</th>
                <th class="text-center">Množství</th>
                <th class="text-right">Cena/ks</th>
                <th class="text-right">Celkem</th>
              </tr>
            </thead>
            <tbody>
              {% for item in orderItems %}
              <tr>
                <td>{{ item.productName }}</td>
                <td class="text-center">{{ item.quantity }}</td>
                <td class="text-right">{{ item.unitPrice }} Kč</td>
                <td class="text-right font-bold">{{ item.totalPrice }} Kč</td>
              </tr>
              {% endfor %}
            </tbody>
            <tfoot>
              {% if order.shippingPrice is not null and order.shippingPrice != 0 %}
              <tr>
                <td colspan="3" class="text-right opacity-70">Doprava{% if shippingMethod is not null %} ({{ shippingMethod.name }}){% endif %}:</td>
                <td class="text-right">{{ order.shippingPrice }} Kč</td>
              </tr>
              {% endif %}
              {% if order.paymentPrice is not null and order.paymentPrice != 0 %}
              <tr>
                <td colspan="3" class="text-right opacity-70">Platba{% if paymentMethod is not null %} ({{ paymentMethod.name }}){% endif %}:</td>
                <td class="text-right">{{ order.paymentPrice }} Kč</td>
              </tr>
              {% endif %}
              <tr class="font-bold text-lg">
                <td colspan="3" class="text-right">Celkem:</td>
                <td class="text-right text-primary">{{ order.totalPrice }} Kč</td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </div>

    <!-- Adresy -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="card bg-base-200">
        <div class="card-body">
          <h2 class="card-title text-base">Fakturační adresa</h2>
          <address class="not-italic opacity-80 leading-relaxed">
            {{ order.billingName }}<br/>
            {{ order.billingStreet }}<br/>
            {{ order.billingZip }} {{ order.billingCity }}<br/>
            {{ order.billingCountry }}
          </address>
        </div>
      </div>
      <div class="card bg-base-200">
        <div class="card-body">
          <h2 class="card-title text-base">Dodací adresa</h2>
          <address class="not-italic opacity-80 leading-relaxed">
            {{ order.deliveryName }}<br/>
            {{ order.deliveryStreet }}<br/>
            {{ order.deliveryZip }} {{ order.deliveryCity }}<br/>
            {{ order.deliveryCountry }}
          </address>
        </div>
      </div>
    </div>

    {% if order.customerNote %}
    <div class="card bg-base-200 mt-6">
      <div class="card-body">
        <h2 class="card-title text-base">Poznámka</h2>
        <p class="opacity-80">{{ order.customerNote }}</p>
      </div>
    </div>
    {% endif %}

    <!-- Doprava a platba -->
    {% if order.shippingMethod is not null or order.paymentMethod is not null %}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
      {% if order.shippingMethod is not null %}
      <div class="card bg-base-200">
        <div class="card-body">
          <h2 class="card-title text-base">Způsob dopravy</h2>
          <div class="flex items-center gap-3">
            {% if order.shippingMethod.icon is not null and order.shippingMethod.icon != "" %}
            <i class="{{ order.shippingMethod.icon }} text-xl"></i>
            {% endif %}
            <div>
              <p class="font-bold">{{ order.shippingMethod.name }}</p>
              {% if order.shippingMethod.description is not null and order.shippingMethod.description != "" %}
              <p class="text-sm opacity-70">{{ order.shippingMethod.description }}</p>
              {% endif %}
            </div>
            <div class="ml-auto font-bold text-primary">
              {% if order.shippingPrice == 0 %}Zdarma{% else %}{{ order.shippingPrice }} Kč{% endif %}
            </div>
          </div>
        </div>
      </div>
      {% endif %}
      {% if order.paymentMethod is not null %}
      <div class="card bg-base-200">
        <div class="card-body">
          <h2 class="card-title text-base">Způsob platby</h2>
          <div class="flex items-center gap-3">
            {% if order.paymentMethod.icon is not null and order.paymentMethod.icon != "" %}
            <i class="{{ order.paymentMethod.icon }} text-xl"></i>
            {% endif %}
            <div>
              <p class="font-bold">{{ order.paymentMethod.name }}</p>
              {% if order.paymentMethod.description is not null and order.paymentMethod.description != "" %}
              <p class="text-sm opacity-70">{{ order.paymentMethod.description }}</p>
              {% endif %}
            </div>
            <div class="ml-auto font-bold text-primary">
              {% if order.paymentPrice == 0 %}Zdarma{% else %}+ {{ order.paymentPrice }} Kč{% endif %}
            </div>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
    {% endif %}

    <!-- Tlačítko pro online platbu -->
    {% if not order.isPaid and order.paymentMethod is not null and order.paymentMethod.gatewayCode != "manual" %}
    <div class="card bg-warning/10 border border-warning mt-6">
      <div class="card-body flex flex-row items-center justify-between gap-4">
        <div>
          <p class="font-bold text-warning">Objednávka čeká na zaplacení</p>
          <p class="text-sm opacity-70">Kliknutím na tlačítko budete přesměrováni na platební bránu.</p>
        </div>
        {% if paymentError is defined and paymentError == "1" %}
        <div class="alert alert-error mb-2 text-sm">Platbu se nepodařilo inicializovat. Zkuste to prosím znovu.</div>
        {% endif %}
        <a href="/order/pay?token={{ order.token }}" class="btn btn-warning whitespace-nowrap">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
          </svg>
          Zaplatit nyní
        </a>
      </div>
    </div>
    {% endif %}

    {% endif %}

    <div class="mt-8">
      <a href="/" class="btn btn-ghost">← Zpět do obchodu</a>
    </div>

  </div>
</div>
{% endblock %}
